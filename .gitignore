# svgMapAppLayers は上流の配布物。以前は .gitmodules の無い gitlink だけが
# 登録されており、クローン先で取得できずビルドが落ちていた。
# 実際に参照されるのは Container が指す2ディレクトリだけなので、それだけを
# 通常ファイルとして取り込み、残り(約44MB)は追跡しない。
/svgMapAppLayers/*
!/svgMapAppLayers/LICENSE
!/svgMapAppLayers/README.md
!/svgMapAppLayers/UPSTREAM.json
!/svgMapAppLayers/Container.svg
!/svgMapAppLayers/basemaps/
!/svgMapAppLayers/appLayers/
/svgMapAppLayers/appLayers/*
!/svgMapAppLayers/appLayers/eStatPopulation/
!/svgMapAppLayers/appLayers/okayamaUniversity/

# 全国detailシャードは map:generate の成果物。114MB あり恒久追跡しない。
# 正規のランタイム形式はこれだが、リポジトリには入れず生成で作る。
/map/data/qtct/*/detail-index.json
/map/data/qtct/*/detail/
