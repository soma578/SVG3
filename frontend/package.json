{
  "name": "svg3-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate:district-svgs": "python3 scripts/generate-district-svgs.py",
    "districts:index": "node scripts/generate-district-assets-index.mjs",
    "districts:check": "node scripts/check-district-assets.mjs",
    "districts:stage": "node scripts/stage-district-artifact.mjs",
    "generate:representative-qtct": "node scripts/generate-representative-qtct.mjs",
    "generate:river-webcams": "node scripts/refresh-river-webcam-source.mjs",
    "webcams:release": "node scripts/build-webcam-release.mjs",
    "webcams:stage": "node scripts/stage-webcam-release.mjs",
    "webcams:automation:check": "node scripts/check-webcam-automation.mjs",
    "river-alerts:publish": "node scripts/publish-river-alert-feed.mjs",
    "river-alerts:check": "node scripts/check-river-alert-publisher.mjs",
    "river-alerts:release": "node scripts/build-river-alert-release.mjs",
    "river-alerts:stage": "node scripts/stage-river-alert-release.mjs",
    "river-alerts:run-provider": "node scripts/run-river-alert-provider.mjs",
    "river-alerts:adapters:check": "node scripts/check-river-alert-adapters.mjs",
    "river-alerts:deploy": "node scripts/run-river-alert-deploy.mjs",
    "river-alerts:deploy:local": "node scripts/run-river-alert-deploy.mjs --deployer local-static",
    "river-alerts:deployers:check": "node scripts/check-river-alert-deployers.mjs",
    "river-alerts:deploy:check": "node scripts/check-river-alert-deploy.mjs",
    "webcams:cache": "node scripts/cache-webcam-images.mjs",
    "layers:check": "node scripts/check-layer-configs.mjs",
    "layers:build": "node scripts/generate-layer-assets.mjs",
    "source-health:check": "node scripts/check-source-health.mjs",
    "publishers:check": "node scripts/check-layer-publishers.mjs",
    "publisher:import": "node scripts/import-publisher-archive.mjs",
    "publisher:import:check": "node scripts/check-publisher-import.mjs",
    "containers:generate": "node scripts/generate-denshi-containers.mjs",
    "assets:prepare": "node scripts/prepare-public-assets.mjs",
    "assets:check": "node scripts/check-public-assets.mjs",
    "containers:check": "node scripts/check-containers.mjs",
    "runtime-import:check": "node scripts/check-runtime-layer-importer.mjs",
    "community-layers:check": "node scripts/check-svgmap-community-compatibility.mjs",
    "community-layers:catalog": "node scripts/generate-svgmap-community-compatibility.mjs",
    "native-poi:check": "node scripts/check-native-poi-refresh.mjs",
    "native-data:check": "node scripts/check-native-data-budget.mjs",
    "native-host:check": "node scripts/check-native-host-contract.mjs",
    "native-startup:check": "node scripts/check-native-startup.mjs",
    "native-region:check": "node scripts/check-region-selector.mjs",
    "native-region-picker:check": "node scripts/check-region-picker.mjs",
    "native-mobile:check": "node scripts/check-mobile-map-contract.mjs",
    "native-alerts:check": "node scripts/check-layer-alert-poller.mjs",
    "native-health:check": "node scripts/check-layer-health.mjs",
    "native-search:check": "node scripts/check-layer-search.mjs",
    "native-panel:check": "node scripts/check-layer-panel.mjs",
    "pipeline:check": "node scripts/check-generated-pipeline.mjs",
    "portable:check": "node scripts/check-portable-layers.mjs",
    "portable:bundle": "node scripts/build-portable-bundles.mjs",
    "region-detail:check": "node scripts/check-region-detail-equivalence.mjs",
    "portable:bundle:check": "node scripts/check-portable-bundles.mjs",
    "portable:index:sign": "node scripts/sign-artifact-index.mjs",
    "portable:bundle:e2e": "npm run assets:check && playwright test --config playwright.portable.config.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:native:e2e": "npm run assets:check && playwright test --config playwright.native.config.mjs",
    "storage:audit": "node scripts/manage-generated-storage.mjs",
    "storage:check": "node scripts/manage-generated-storage.mjs --check",
    "storage:clean": "node scripts/manage-generated-storage.mjs --apply",
    "architecture:check": "npm run layers:check && npm run community-layers:check && npm run runtime-import:check && npm run portable:check && npm run native-host:check && npm run pipeline:check && npm run storage:check",
    "map:generate": "node ../scripts/extract_evacuation_svg_data.mjs && npm run generate:district-svgs && npm run districts:index && npm run generate:representative-qtct && npm run community-layers:catalog && npm run layers:check && npm run layers:build && npm run generate:municipality-index && npm run generate:offline-basemap && npm run containers:generate && npm run generate:pwa-icons && npm run sw:generate",
    "map:verify": "npm run test && npm run districts:check && npm run source-health:check && npm run webcams:automation:check && npm run river-alerts:check && npm run river-alerts:adapters:check && npm run river-alerts:deployers:check && npm run river-alerts:deploy:check && npm run publishers:check && npm run publisher:import:check && npm run architecture:check && npm run runtime-import:check && npm run native-startup:check && npm run native-alerts:check && npm run native-health:check && npm run native-search:check && npm run native-panel:check && npm run native-data:check && npm run sw:check && npm run region-detail:check",
    "map:release": "npm run portable:bundle && npm run portable:bundle:check",
    "map:sync": "npm run assets:prepare && npm run assets:check && npm run containers:check",
    "map:build": "npm run map:generate && npm run map:verify && npm run map:release && npm run map:sync",
    "predev": "npm run assets:prepare -- --if-missing && npm run assets:check",
    "dev": "next dev",
    "dev:native": "node scripts/static-map-server.mjs",
    "prebuild": "npm run map:build",
    "build": "next build && node scripts/check-public-assets.mjs",
    "start": "next start",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "generate:pwa-icons": "node scripts/generate-pwa-icons.mjs",
    "sw:generate": "node scripts/generate-service-worker.mjs",
    "sw:check": "node scripts/check-service-worker.mjs",
    "generate:offline-basemap": "node scripts/generate-offline-basemap.mjs",
    "generate:municipality-index": "node scripts/generate-municipality-index.mjs"
  },
  "dependencies": {
    "next": "^16.2.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3"
  }
}
