{
  "id": "layer-hazard",
  "title": "L4 ハザード",
  "href": "/map/layers/portable/hazard/hazardLayer.svg#prefSvgUrl=/map/layers/hazard/{prefCodeNum}/{regionId}.svg&svgUrlTemplate=/map/layers/hazard/{prefCodeNum}/districts/{code}.svg&layerKey={layerId}",
  "class": "vectorEtcData",
  "visibility": "visible",
  "opacity": "0.7",
  "order": 80,
  "layerPackage": "/map/layers/portable/hazard/layer.package.json",
  "crossRegion": {
    "label": "ハザード",
    "note": "{label}の洪水・土砂災害ハザードを越境して重ねる"
  },
  "ui": {
    "catalog": true,
    "group": "防災情報",
    "symbol": "災",
    "accent": "#AD3F31",
    "kind": "vector",
    "note": "洪水・土砂災害などのハザード表示",
    "controllerUi": {
      "label": "種類"
    },
    "messages": {
      "toHost": [
        "runtime:dataStatus",
        "runtime:layerReady",
        "runtime:layerStateChanged"
      ],
      "fromHost": [
        "map:layerVisibilityChanged",
        "map:setMunicipalityFilter",
        "map:setLayerState"
      ]
    },
    "visibilityStrategy": "controller",
    "attributions": [
      {
        "kind": "flood",
        "name": "洪水浸水想定区域 A31",
        "url": "https://nlftp.mlit.go.jp/ksj/gml/datalist/KsjTmplt-A31.html"
      },
      {
        "kind": "tsunami",
        "name": "津波浸水想定 A40",
        "url": "https://nlftp.mlit.go.jp/ksj/gml/datalist/KsjTmplt-A40.html"
      },
      {
        "kind": "landslide",
        "name": "土砂災害警戒区域 A33（2018年度版）",
        "url": "https://nlftp.mlit.go.jp/ksj/gml/datalist/KsjTmplt-A33-2018.html"
      }
    ]
  }
}
