{
  "id": "layer-japan-river-webcams",
  "title": "全国河川監視カメラ",
  "href": "/map/layers/portable/japan-river-webcams/webcamLayer.svg#summary=/map/data/qtct/japanRiverWebcam/summary.json&data=/map/data/qtct/japanRiverWebcam/detail-index.json&layer=japanRiverWebcam&detailByRegion=/map/data/qtct/japanRiverWebcam/{recordRegionId}/detail.json",
  "class": "poi clickable",
  "visibility": "hidden",
  "opacity": "1",
  "extent": "japan",
  "order": 66,
  "layerPackage": "/map/layers/portable/japan-river-webcams/layer.package.json",
  "bundle": {
    "release": true,
    "summaryMaxDepth": 12
  },
  "ui": {
    "catalog": true,
    "group": "河川確認",
    "symbol": "カ",
    "accent": "#176A63",
    "kind": "poi",
    "note": "国土交通省 川の防災情報（2026年4月28日取得の固定台帳・暫定表示）",
    "showHealth": false,
    "messages": {
      "toHost": [
        "runtime:dataStatus"
      ],
      "fromHost": []
    }
  },
  "dataSource": {
    "ownership": "external",
    "authority": {
      "name": "国土交通省 川の防災情報",
      "url": "https://www.river.go.jp/"
    },
    "delivery": "static-snapshot",
    "runtimeFetch": false,
    "snapshot": {
      "timestampField": "updatedAt"
    },
    "health": "/map/data/source-health/japanRiverWebcam.json",
    "freshness": {
      "staleAfterMinutes": 64800
    },
    "refreshPolicy": {
      "minimumIntervalMinutes": 28800,
      "requestDelayMs": 500,
      "timeoutSeconds": 20,
      "maxConcurrency": 2,
      "minimumCoverageRatio": 0.9,
      "retainLastGood": true
    }
  },
  "imagePolicy": {
    "mode": "user-action-direct",
    "allowedHosts": [
      "cam.river.go.jp",
      "www.river.go.jp"
    ],
    "prefetch": false,
    "autoRefresh": false,
    "refreshCooldownSeconds": 30,
    "runtimeFeatureFlag": "./webcam-runtime-policy.json#riverWebcamImages.enabled"
  },
  "build": {
    "kind": "webcam-qtct",
    "qtctLayer": "japanRiverWebcam",
    "summaryShardDepth": 2,
    "detailShardDepth": 2,
    "source": "../../../sources/japan-river-webcams/cameras.json"
  }
