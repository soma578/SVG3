{
  "id": "layer-river-level",
  "title": "河川水位",
  "href": "/map/layers/portable/river-level/riverLevelLayer.svg#summary=/map/data/qtct/riverLevel/summary.json&data=/map/data/qtct/riverLevel/{regionId}/detail.json&layer=riverLevel&detailByRegion=/map/data/qtct/riverLevel/{recordRegionId}/detail.json",
  "class": "poi clickable",
  "visibility": "hidden",
  "opacity": "1",
  "extent": "japan",
  "order": 65,
  "layerPackage": "/map/layers/portable/river-level/layer.package.json",
  "bundle": {
    "release": true
  },
  "ui": {
    "catalog": false,
    "disabled": true,
    "group": "河川確認",
    "symbol": "水",
    "accent": "#176A63",
    "kind": "poi",
    "note": "河川水位と危険段階（現在は配信adapter接続待ち）",
    "alertFeed": {
      "url": "/map/data/alerts/riverLevel.json",
      "pollMs": 120000,
      "staleAfterMinutes": 20
    },
    "messages": null
  },
  "dataSource": {
    "ownership": "external",
    "authority": {
      "name": "水防災オープンデータ提供サービス",
      "url": "https://www.river.or.jp/koeki/opendata/index.html"
    },
    "delivery": "scheduled-snapshot",
    "runtimeFetch": false,
    "snapshot": {
      "timestampField": "properties.observedAt"
    },
    "health": "/map/data/source-health/riverLevel.json",
    "freshness": {
      "staleAfterMinutes": 20
    },
    "refreshPolicy": {
      "minimumIntervalMinutes": 5,
      "requestDelayMs": 300000,
      "timeoutSeconds": 60,
      "maxConcurrency": 1,
      "minimumCoverageRatio": 0.9,
      "retainLastGood": true
    }
  },
  "publication": "/map/layers/managed/river-level/publication.json",
  "build": {
    "kind": "csv-qtct",
    "source": "data.csv",
    "qtctLayer": "riverLevel",
    "idColumn": "id",
    "titleColumn": "title",
    "latitudeColumn": "lat",
    "longitudeColumn": "lon",
    "regionColumn": "regionId",
    "statusColumn": "status",
    "propertyColumns": {
      "river": {
        "column": "river",
        "type": "string"
      },
      "location": {
        "column": "location",
        "type": "string"
      },
      "currentLevel": {
        "column": "currentLevel",
        "type": "number"
      },
      "change1h": {
        "column": "change1h",
        "type": "number"
      },
      "advisoryLevel": {
        "column": "advisoryLevel",
        "type": "number"
      },
      "evacuationLevel": {
        "column": "evacuationLevel",
        "type": "number"
      },
      "dangerLevel": {
        "column": "dangerLevel",
        "type": "number"
      },
      "unit": {
        "column": "unit",
        "type": "string"
      },
      "observedAt": {
        "column": "observedAt",
        "type": "string"
      },
      "sourceUrl": {
        "column": "sourceUrl",
        "type": "string"
      },
      "quality": {
        "column": "quality",
        "type": "string"
      }
    }
  }
}
