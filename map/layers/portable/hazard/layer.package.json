{
  "id": "hazard",
  "title": "Hazard Portable Layer",
  "version": "1.0.0",
  "entrypoint": "hazardLayer.svg",
  "type": "svgmap-portable-layer",
  "distribution": {
    "publisher": { "id": "svg3", "name": "SVG3" },
    "license": { "spdx": "NOASSERTION", "name": "利用条件未設定", "status": "unresolved", "redistributable": false },
    "publishedAt": "2026-07-24T00:00:00+09:00"
  },
  "portability": {
    "level": "workspace-portable",
    "dataInjection": "hash-params",
    "limitations": ["Hazard SVG data must be supplied by the mounting environment"]
  },
  "runtime": {
    "lawaModes": ["tight", "isolated"],
    "readyEvent": "layerWebAppReady",
    "requiredApis": ["svgMap.getGeoViewBox", "svgMap.refreshScreen", "svgImage"]
  },
  "runtimeDependencies": [
    { "id": "representative-pins", "version": "1.2.3", "manifest": "../representative-pins/runtime.package.json" },
    { "id": "svgmap-slawa-client", "version": "1.0.0", "manifest": "../svgmap-slawa-client/runtime.package.json" }
  ],
  "shared": ["hazardLayer.html"],
  "data": {
    "kind": "svg-template",
    "injection": {
      "transport": "svg-fragment-query",
      "required": ["prefSvgUrl", "layerKey"],
      "optional": ["svgUrlTemplate", "overviewIndexUrl", "prefCode"]
    }
  },
  "containerAnimation": {
    "class": "vectorEtcData",
    "visibility": "hidden",
    "opacity": "0.7"
  }
}
