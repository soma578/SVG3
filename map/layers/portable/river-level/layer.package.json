{
  "id": "riverLevel",
  "title": "River Level Portable Layer",
  "version": "1.1.0",
  "type": "svgmap-portable-layer",
  "distribution": {
    "publisher": { "id": "svg3", "name": "SVG3" },
    "license": { "spdx": "NOASSERTION", "name": "利用条件未設定", "status": "unresolved", "redistributable": false },
    "publishedAt": "2026-08-28T00:00:00+09:00"
  },
  "entrypoint": "riverLevelLayer.svg",
  "portability": {
    "level": "distribution-portable",
    "dataInjection": "hash-params",
    "limitations": []
  },
  "runtime": {
    "lawaModes": ["tight", "isolated"],
    "readyEvent": "layerWebAppReady",
    "requiredApis": ["svgMap.getGeoViewBox", "svgMap.setShowPoiProperty", "svgMap.showModal", "svgImage"]
  },
  "runtimeDependencies": [
    { "id": "representative-pins", "version": "1.2.3", "manifest": "../representative-pins/runtime.package.json" },
    { "id": "svgmap-slawa-client", "version": "1.0.0", "manifest": "../svgmap-slawa-client/runtime.package.json" },
    { "id": "portable-network", "version": "1.0.0", "manifest": "../portable-network/runtime.package.json" }
  ],
  "network": {
    "schemaVersion": 1,
    "mode": "snapshot-required",
    "runtimeExternalFetch": false,
    "allowedOrigins": [],
    "minimumIntervalSeconds": 0,
    "maxConcurrency": 1,
    "cacheSeconds": 120,
    "retry": {
      "maxAttempts": 1,
      "backoffMilliseconds": 0
    },
    "provider": {
      "kind": "companion-publisher",
      "minimumIntervalSeconds": 600,
      "maxConcurrency": 1
    },
    "failClosed": true
  },
  "detailMode": "svgMap.showModal",
  "capabilities": [
    "feature-detail",
    "qtct",
    "status-icons"
  ],
  "shared": [
    "riverLevelDetail.js"
  ],
  "data": {
    "kind": "qtct",
    "injection": {
      "transport": "svg-fragment-query",
      "required": ["data", "layer"],
      "optional": ["summary", "statusOverlay", "profile", "municipalityCodes", "districtSvgUrlTemplate"]
    }
  }
}
