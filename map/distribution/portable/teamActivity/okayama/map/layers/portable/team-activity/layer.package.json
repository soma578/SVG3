      "version": "1.0.0",
      "manifest": "../svgmap-slawa-client/runtime.package.json"
    }
  ],
  "detailMode": "svgMap.showModal",
  "shared": [
    "teamActivityDetail.js",
    "teamActivityCsv.js",
    "appLayersAdmin.html",
    "teamActivityAreaLayer.svg",
    "teamActivityAreaLayer.html"
