  "containerAnimations": [
    {
      "id": "layer-team-activity-pins",
      "entrypoint": "teamActivityLayer.svg",
      "title": "チーム活動ピン",
      "class": "poi clickable",
      "opacity": "1",
      "primary": true,
      "dataParams": [
        "summary",
        "data",
        "sourceCsv",
        "layer"
      ]
    },
    {
      "id": "layer-team-activity",
      "entrypoint": "teamActivityAreaLayer.svg",
