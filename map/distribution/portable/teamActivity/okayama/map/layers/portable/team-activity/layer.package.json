      "dataParams": [
        "data",
        "districtSvgUrlTemplate",
        "layer"
      ]
    }
  ],
  "data": {
    "kind": "qtct",
    "injection": {
      "transport": "svg-document-attributes",
      "required": [
        "data",
        "layer"
      ],
      "optional": [
        "summary",
        "sourceCsv",
        "statusOverlay",
        "profile",
        "municipalityCodes",
        "districtSvgUrlTemplate"
      ],
      "fallbackTransport": "svg-fragment-query"
